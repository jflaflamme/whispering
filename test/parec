#!/bin/sh
# Stand-in for parec in tests: streams a WAV in real time as 16 kHz mono
# s16le, then silence. Never touches PipeWire or the call audio.
# WHISPERING_TEST_WAV: the file for every source.
# WHISPERING_TEST_DIR: a folder with one <source>.wav per source (e.g. mic.wav, spk.wav).
src=""
while [ $# -gt 0 ]; do
  [ "$1" = "-d" ] && src="$2"
  shift
done
wav="$WHISPERING_TEST_WAV"
[ -n "$WHISPERING_TEST_DIR" ] && wav="$WHISPERING_TEST_DIR/$src.wav"
# Both inputs are read in real time (-re): with "-af apad" the silence after the file
# came out as fast as possible (25 s of test wrote hours of audio).
exec ffmpeg -loglevel error -re -i "$wav" -re -f lavfi -i anullsrc=r=16000:cl=mono \
  -filter_complex "[0]aresample=16000,aformat=sample_fmts=s16:channel_layouts=mono[a];[a][1]concat=n=2:v=0:a=1" \
  -f s16le -
